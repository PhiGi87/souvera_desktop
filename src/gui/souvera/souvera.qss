 *
 * Souvera Design System — tokenized stylesheet.
 * Tokens are substituted by SouveraTheme at runtime (dark + light).
 * Grid: 8dp / 12dp / 16dp / 24dp
 */

/* ==========================================================================
   Base
   ========================================================================== */

SouveraMainWindow {
    background-color: @background@;
}

QWidget#ContentArea {
    background-color: @contentBackground@;
}

/* ==========================================================================
   Left Sidebar
   ========================================================================== */

#LeftSidebar {
    background-color: @sidebarBackground@;
    border-right: 1px solid @border@;
}

#LeftSidebar QPushButton#SidebarButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: @textMuted@;
    min-width: 64px;
    min-height: 56px;
    padding: 0;
    font-size: 10px;
}

#LeftSidebar QPushButton#SidebarButton:hover {
    background: @overlayHover@;
    color: @textSecondary@;
}

#LeftSidebar QPushButton#SidebarButton:checked {
    background: @accentOverlay@;
    border-left: 3px solid @accentSecondary@;
    color: @textPrimary@;
}

#LeftSidebar QPushButton#SidebarButton:checked:hover {
    background: @accentOverlayHover@;
}

QLabel#SidebarIcon {
    background: transparent;
}

QLabel#SidebarText {
    font-size: 9px;
    color: inherit;
    background: transparent;
}

#SidebarAvatar {
    background: @accentOverlay@;
    color: @accent@;
    border: 2px solid @borderStrong@;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    padding: 0;
}

#SidebarAvatar:hover {
    border-color: @accent@;
    background: @accentOverlayHover@;
}

#ThemeToggleButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
    color: @textMuted@;
}

#ThemeToggleButton:hover {
    background: @overlayHover@;
    border-color: @borderStrong@;
    color: @textPrimary@;
}

/* ==========================================================================
   Status Header
   ========================================================================== */

#StatusHeader {
    background-color: @background@;
    border-bottom: 1px solid @border@;
    min-height: 44px;
    max-height: 44px;
}

#StatusHeader QLabel#UserEmailLabel {
    color: @textPrimary@;
    font-size: 13px;
    font-weight: 600;
}

#StatusHeader QLabel#SyncIconLabel {
    color: @success@;
    font-size: 14px;
}

#StatusHeader QLabel#SyncTextLabel {
    color: @textSecondary@;
    font-size: 12px;
}

#StatusHeader QPushButton#SettingsButton {
    color: @textMuted@;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

#StatusHeader QPushButton#SettingsButton:hover {
    color: @textPrimary@;
    background: @overlayHoverStrong@;
}

/* ==========================================================================
   Mail Panel
   ========================================================================== */

#MailToolbar {
    background-color: @background@;
    border-bottom: 1px solid @border@;
    min-height: 44px;
}

QLabel#MailToolbarTitle {
    color: @textPrimary@;
    font-size: 15px;
    font-weight: 600;
}

QLabel#MailSendAsLabel {
    color: @textMuted@;
    font-size: 12px;
}

QPushButton#MailComposeBtn {
    background: @accentGradient@;
    color: @onAccent@;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#MailComposeBtn:hover {
    background-color: @accentHover@;
}

QPushButton#MailComposeBtn:pressed {
    background-color: @accentPressed@;
}

QPushButton#MailReplyBtn,
QPushButton#MailDeleteBtn,
QPushButton#MailRefreshBtn {
    background: transparent;
    color: @textSecondary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#MailReplyBtn:hover,
QPushButton#MailDeleteBtn:hover,
QPushButton#MailRefreshBtn:hover {
    background: @surface@;
    color: @textPrimary@;
    border-color: @borderStrong@;
}

QPushButton#MailReplyBtn:disabled,
QPushButton#MailDeleteBtn:disabled {
    color: @textDisabled@;
    border-color: @border@;
}

QComboBox#MailSendAsCombo {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 30px;
}

QComboBox#MailSendAsCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#MailSendAsCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @textMuted@;
    margin-right: 6px;
}

QComboBox#MailSendAsCombo:hover {
    border-color: @borderStrong@;
}

QComboBox#MailSendAsCombo QAbstractItemView {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 6px;
    selection-background-color: @accentOverlayHover@;
    selection-color: @textPrimary@;
    outline: none;
}

/* ---- MailSplitter ---- */

QSplitter#MailSplitter::handle {
    background-color: @border@;
    width: 1px;
}

/* ---- Folder Panel ---- */

#MailFolderPanel {
    background-color: @background@;
    border-right: 1px solid @border@;
}

#MailFolderView {
    background: transparent;
    color: @textSecondary@;
    font-size: 13px;
    border: none;
    outline: none;
}

#MailFolderView::item {
    padding: 8px 16px;
    border-radius: 6px;
    margin: 1px 6px;
}

#MailFolderView::item:selected {
    background: @accentOverlayHover@;
    color: @accent@;
}

#MailFolderView::item:hover:!selected {
    background: @overlayHover@;
    color: @textPrimary@;
}

/* ---- Message List ---- */

#MailMessagePanel {
    background-color: @contentBackground@;
    border-right: 1px solid @border@;
}

#MailMessageView {
    background: transparent;
    color: @textPrimary@;
    font-size: 13px;
    border: none;
    outline: none;
    alternate-background-color: @overlayHover@;
}

#MailMessageView::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 1px 6px;
    border-bottom: 1px solid @overlayHover@;
}

#MailMessageView::item:selected {
    background: @accentOverlay@;
    color: @textPrimary@;
}

#MailMessageView::item:hover:!selected {
    background: @overlayHover@;
}

/* ---- Preview Panel ---- */

#MailPreviewPanel {
    background-color: @contentBackground@;
}

#MailPreview {
    background: @background@;
    color: @textPrimary@;
    font-size: 13px;
    border: none;
    padding: 20px;
    selection-background-color: @accentOverlayHover@;
    selection-color: @textPrimary@;
}

/* ==========================================================================
   Files Panel
   ========================================================================== */

#FilesPanel {
    background-color: @contentBackground@;
}

QLabel#FilesHeaderLabel {
    color: @textPrimary@;
    font-size: 18px;
    font-weight: 700;
    padding: 0 0 16px 0;
}

#FilesPanel QLabel#FolderAliasLabel {
    color: @textPrimary@;
    font-size: 14px;
    font-weight: 600;
}

#FilesPanel QLabel#FolderStatusLabel {
    color: @textSecondary@;
    font-size: 12px;
}

#FilesPanel QLabel#FolderErrorLabel {
    color: @danger@;
    font-size: 11px;
    padding: 4px 0 0 0;
}

#FilesPanel QPushButton {
    color: @accent@;
    background: transparent;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

#FilesPanel QPushButton:hover {
    color: @onAccent@;
    background: @accent@;
    border-color: @accent@;
}

#FilesPanel QLabel#EmptyLabel {
    color: @textDisabled@;
    font-size: 14px;
    padding: 48px 0;
}

#FolderRow {
    background: @background@;
    border: 1px solid @border@;
    border-radius: 10px;
    min-height: 60px;
}

#FolderRow:hover {
    background: @surfaceHover@;
    border-color: @borderStrong@;
}

QProgressBar#FolderProgressBar {
    background: @surface@;
    border: none;
    border-radius: 3px;
    min-height: 4px;
    max-height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar#FolderProgressBar::chunk {
    background: @accent@;
    border-radius: 3px;
}

/* ==========================================================================
   General Widgets
   ========================================================================== */

QToolTip {
    background: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---- Scrollbars ---- */

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: @borderStrong@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @textMuted@;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: @borderStrong@;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: @textMuted@;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
