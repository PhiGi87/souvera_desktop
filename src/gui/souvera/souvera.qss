 * Souvera Design System — Dark Professional
 * Palette: Deep Indigo + Cyan Accent
 * Grid: 8dp / 12dp / 16dp / 24dp
 */

/* ==========================================================================
   Base
   ========================================================================== */

SouveraMainWindow {
    background-color: #0f1729;
}

QWidget#ContentArea {
    background-color: #161a2e;
}

/* ==========================================================================
   Left Sidebar
   ========================================================================== */

#LeftSidebar {
    background-color: #0b1120;
    border-right: 1px solid #1e293b;
}

#LeftSidebar QPushButton#SidebarButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #64748b;
    min-width: 64px;
    min-height: 56px;
    padding: 0;
    font-size: 10px;
}

#LeftSidebar QPushButton#SidebarButton:hover {
    background: rgba(255, 255, 255, 0.04);
    color: #94a3b8;
}

#LeftSidebar QPushButton#SidebarButton:checked {
    background: rgba(75, 191, 234, 0.08);
    border-left: 3px solid #4BBFEA;
    color: #e2e8f0;
}

#LeftSidebar QPushButton#SidebarButton:checked:hover {
    background: rgba(75, 191, 234, 0.12);
}

QLabel#SidebarIcon {
    font-size: 22px;
    color: inherit;
    background: transparent;
}

QLabel#SidebarText {
    font-size: 9px;
    color: inherit;
    background: transparent;
}

#SidebarAvatar {
    background: #1e3a5f;
    color: #4BBFEA;
    border: 2px solid #334155;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    padding: 0;
}

#SidebarAvatar:hover {
    border-color: #4BBFEA;
    background: #23456b;
}

/* ==========================================================================
   Status Header
   ========================================================================== */

#StatusHeader {
    background-color: #0f1729;
    border-bottom: 1px solid #1e293b;
    min-height: 44px;
    max-height: 44px;
}

#StatusHeader QLabel#UserEmailLabel {
    color: #e2e8f0;
    font-size: 13px;
    font-weight: 600;
}

#StatusHeader QLabel#SyncIconLabel {
    color: #22c55e;
    font-size: 14px;
}

#StatusHeader QLabel#SyncTextLabel {
    color: #94a3b8;
    font-size: 12px;
}

#StatusHeader QPushButton#SettingsButton {
    color: #64748b;
    background: transparent;
    border: none;
    font-size: 18px;
    padding: 4px 8px;
    border-radius: 6px;
}

#StatusHeader QPushButton#SettingsButton:hover {
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.06);
}

/* ==========================================================================
   Mail Panel
   ========================================================================== */

#MailToolbar {
    background-color: #0f1729;
    border-bottom: 1px solid #1e293b;
    min-height: 44px;
}

QLabel#MailToolbarTitle {
    color: #e2e8f0;
    font-size: 15px;
    font-weight: 600;
}

QLabel#MailSendAsLabel {
    color: #64748b;
    font-size: 12px;
}

QPushButton#MailComposeBtn {
    background-color: #4BBFEA;
    color: #0f1729;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#MailComposeBtn:hover {
    background-color: #38bdf8;
}

QPushButton#MailComposeBtn:pressed {
    background-color: #0ea5e9;
}

QPushButton#MailReplyBtn,
QPushButton#MailDeleteBtn,
QPushButton#MailRefreshBtn {
    background: transparent;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#MailReplyBtn:hover,
QPushButton#MailDeleteBtn:hover,
QPushButton#MailRefreshBtn:hover {
    background: #1e293b;
    color: #e2e8f0;
    border-color: #475569;
}

QPushButton#MailReplyBtn:disabled,
QPushButton#MailDeleteBtn:disabled {
    color: #475569;
    border-color: #1e293b;
}

QComboBox#MailSendAsCombo {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 30px;
}

QComboBox#MailSendAsCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#MailSendAsCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748b;
    margin-right: 6px;
}

QComboBox#MailSendAsCombo:hover {
    border-color: #475569;
}

QComboBox#MailSendAsCombo QAbstractItemView {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    selection-background-color: rgba(75, 191, 234, 0.2);
    selection-color: #e2e8f0;
    outline: none;
}

/* ---- MailSplitter ---- */

QSplitter#MailSplitter::handle {
    background-color: #1e293b;
    width: 1px;
}

/* ---- Folder Panel ---- */

#MailFolderPanel {
    background-color: #0f1729;
    border-right: 1px solid #1e293b;
}

#MailFolderView {
    background: transparent;
    color: #cbd5e1;
    font-size: 13px;
    border: none;
    outline: none;
}

#MailFolderView::item {
    padding: 8px 16px;
    border-radius: 6px;
    margin: 1px 6px;
}

#MailFolderView::item:selected {
    background: rgba(75, 191, 234, 0.12);
    color: #4BBFEA;
}

#MailFolderView::item:hover:!selected {
    background: rgba(255, 255, 255, 0.04);
    color: #e2e8f0;
}

/* ---- Message List ---- */

#MailMessagePanel {
    background-color: #161a2e;
    border-right: 1px solid #1e293b;
}

#MailMessageView {
    background: transparent;
    color: #e2e8f0;
    font-size: 13px;
    border: none;
    outline: none;
    alternate-background-color: rgba(255, 255, 255, 0.015);
}

#MailMessageView::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 1px 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

#MailMessageView::item:selected {
    background: rgba(75, 191, 234, 0.10);
    color: #e2e8f0;
}

#MailMessageView::item:hover:!selected {
    background: rgba(255, 255, 255, 0.03);
}

/* ---- Preview Panel ---- */

#MailPreviewPanel {
    background-color: #161a2e;
}

#MailPreview {
    background: #0f1729;
    color: #e2e8f0;
    font-size: 13px;
    line-height: 1.6;
    border: none;
    padding: 20px;
    selection-background-color: rgba(75, 191, 234, 0.3);
    selection-color: #ffffff;
}

/* ==========================================================================
   Files Panel
   ========================================================================== */

#FilesPanel {
    background-color: #161a2e;
}

QLabel#FilesHeaderLabel {
    color: #e2e8f0;
    font-size: 18px;
    font-weight: 700;
    padding: 0 0 16px 0;
}

#FilesPanel QLabel#FolderAliasLabel {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 600;
}

#FilesPanel QLabel#FolderStatusLabel {
    color: #94a3b8;
    font-size: 12px;
}

#FilesPanel QLabel#FolderErrorLabel {
    color: #ef4444;
    font-size: 11px;
    padding: 4px 0 0 0;
}

#FilesPanel QPushButton {
    color: #4BBFEA;
    background: transparent;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

#FilesPanel QPushButton:hover {
    color: #0f1729;
    background: #4BBFEA;
    border-color: #4BBFEA;
}

#FilesPanel QLabel#EmptyLabel {
    color: #475569;
    font-size: 14px;
    padding: 48px 0;
}

#FolderRow {
    background: #0f1729;
    border: 1px solid #1e293b;
    border-radius: 10px;
    min-height: 60px;
}

#FolderRow:hover {
    background: #1a2540;
    border-color: #334155;
}

QProgressBar#FolderProgressBar {
    background: #1e293b;
    border: none;
    border-radius: 3px;
    min-height: 4px;
    max-height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar#FolderProgressBar::chunk {
    background: #4BBFEA;
    border-radius: 3px;
}

/* ==========================================================================
   General Widgets
   ========================================================================== */

QToolTip {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---- Scrollbars ---- */

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
