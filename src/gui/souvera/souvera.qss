 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * Souvera Design System — tokenized stylesheet.
 * Tokens are substituted by SouveraTheme at runtime (dark + light).
 * Grid: 8dp / 12dp / 16dp / 24dp
 */

/* ==========================================================================
   Base
   ========================================================================== */

SouveraMainWindow {
    background-color: @background@;
}

QWidget#ContentArea {
    background-color: @contentBackground@;
}

/* Generic widgets inside the content area (incl. inherited Nextcloud
   settings widgets) must never render dark-on-dark: force theme colors. */
QWidget#ContentArea QLabel {
    color: @textPrimary@;
    background: transparent;
}

QWidget#ContentArea QCheckBox,
QWidget#ContentArea QRadioButton {
    color: @textPrimary@;
    background: transparent;
    spacing: 8px;
}

QWidget#ContentArea QGroupBox {
    color: @textPrimary@;
    border: 1px solid @border@;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}

QWidget#ContentArea QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: @textSecondary@;
}

QWidget#ContentArea QLineEdit,
QWidget#ContentArea QSpinBox {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: @accent@;
    selection-color: @onAccent@;
}

QWidget#ContentArea QComboBox {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 8px;
}

QWidget#ContentArea QComboBox QAbstractItemView {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    selection-background-color: @accentOverlayHover@;
    selection-color: @textPrimary@;
}

/* ==========================================================================
   Left Sidebar
   ========================================================================== */

#LeftSidebar {
    background-color: @sidebarBackground@;
    border-right: 1px solid @border@;
}

#LeftSidebar QPushButton#SidebarButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: @textMuted@;
    min-width: 72px;
    min-height: 56px;
    padding: 0;
    font-size: 10px;
}

#LeftSidebar QPushButton#SidebarButton:hover {
    background: @overlayHover@;
    color: @textSecondary@;
}

#LeftSidebar QPushButton#SidebarButton:checked {
    background: @accentOverlay@;
    border-left: 3px solid @accentSecondary@;
    color: @textPrimary@;
}

#LeftSidebar QPushButton#SidebarButton:checked:hover {
    background: @accentOverlayHover@;
}

QLabel#SidebarIcon {
    background: transparent;
}

QLabel#SidebarText {
    font-size: 9px;
    color: inherit;
    background: transparent;
}

#SidebarAvatar {
    background: @accentOverlay@;
    color: @accent@;
    border: 2px solid @borderStrong@;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    padding: 0;
}

#SidebarAvatar:hover {
    border-color: @accent@;
    background: @accentOverlayHover@;
}

#ThemeToggleButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
    color: @textMuted@;
}

#ThemeToggleButton:hover {
    background: @overlayHover@;
    border-color: @borderStrong@;
    color: @textPrimary@;
}

/* ==========================================================================
   Status Header
   ========================================================================== */

#StatusHeader {
    background-color: @background@;
    border-bottom: 1px solid @border@;
    min-height: 44px;
    max-height: 44px;
}

#StatusHeader QLabel#UserEmailLabel {
    color: @textPrimary@;
    font-size: 13px;
    font-weight: 600;
}

#StatusHeader QLabel#SyncIconLabel {
    color: @success@;
    font-size: 14px;
}

#StatusHeader QLabel#SyncTextLabel {
    color: @textSecondary@;
    font-size: 12px;
}

#StatusHeader QPushButton#SettingsButton {
    color: @textMuted@;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

#StatusHeader QPushButton#SettingsButton:hover {
    color: @textPrimary@;
    background: @overlayHoverStrong@;
}

/* ==========================================================================
   Mail Panel
   ========================================================================== */

#MailToolbar {
    background-color: @background@;
    border-bottom: 1px solid @border@;
    min-height: 44px;
}

QLabel#MailToolbarTitle {
    color: @textPrimary@;
    font-size: 15px;
    font-weight: 600;
}

QLabel#MailSendAsLabel {
    color: @textMuted@;
    font-size: 12px;
}

QPushButton#MailComposeBtn {
    background: @accentGradient@;
    color: @onAccent@;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#MailComposeBtn:hover {
    background-color: @accentHover@;
}

QPushButton#MailComposeBtn:pressed {
    background-color: @accentPressed@;
}

QPushButton#MailReplyBtn,
QPushButton#MailDeleteBtn,
QPushButton#MailRefreshBtn {
    background: transparent;
    color: @textSecondary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#MailReplyBtn:hover,
QPushButton#MailDeleteBtn:hover,
QPushButton#MailRefreshBtn:hover {
    background: @surface@;
    color: @textPrimary@;
    border-color: @borderStrong@;
}

QPushButton#MailReplyBtn:disabled,
QPushButton#MailDeleteBtn:disabled {
    color: @textDisabled@;
    border-color: @border@;
}

/* Mail status bar + search */
QLabel#MailStatusLabel {
    background-color: @background@;
    color: @textMuted@;
    border-top: 1px solid @border@;
    min-height: 22px;
    max-height: 22px;
}

QLineEdit#MailSearchEdit {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    min-height: 16px;
}

QLineEdit#MailSearchEdit:focus {
    border: 1px solid @accent@;
}

QComboBox#MailSendAsCombo {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 30px;
}

QComboBox#MailSendAsCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#MailSendAsCombo::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @textMuted@;
    margin-right: 6px;
}

QComboBox#MailSendAsCombo:hover {
    border-color: @borderStrong@;
}

QComboBox#MailSendAsCombo QAbstractItemView {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 6px;
    selection-background-color: @accentOverlayHover@;
    selection-color: @textPrimary@;
    outline: none;
}

/* ---- MailSplitter ---- */

QSplitter#MailSplitter::handle {
    background-color: @border@;
    width: 1px;
}

/* ---- Folder Panel ---- */

#MailFolderPanel {
    background-color: @background@;
    border-right: 1px solid @border@;
}

#MailFolderView {
    background: transparent;
    color: @textSecondary@;
    font-size: 13px;
    border: none;
    outline: none;
    show-decoration-selected: 0;
}

#MailFolderView::item {
    height: 30px;
    border-radius: 6px;
    margin: 1px 8px 1px 2px;
    padding-left: 4px;
}

#MailFolderView::item:selected {
    background: @accentOverlayHover@;
    color: @accent@;
}

#MailFolderView::item:hover:!selected {
    background: @overlayHover@;
    color: @textPrimary@;
}

/* Chevron expand/collapse indicators instead of the default tree arrows */
#MailFolderView::branch {
    background: transparent;
    border-image: none;
}

#MailFolderView::branch:closed:has-children {
    image: url(:/souvera/icons/chevron-right.svg);
}

#MailFolderView::branch:open:has-children {
    image: url(:/souvera/icons/chevron-down.svg);
}

/* ---- Message List ---- */

#MailMessagePanel {
    background-color: @contentBackground@;
    border-right: 1px solid @border@;
}

#MailMessageView {
    background: transparent;
    color: @textPrimary@;
    font-size: 13px;
    border: none;
    outline: none;
    alternate-background-color: @overlayHover@;
}

#MailMessageView::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 1px 6px;
    border-bottom: 1px solid @overlayHover@;
}

#MailMessageView::item:selected {
    background: @accentOverlay@;
    color: @textPrimary@;
}

#MailMessageView::item:hover:!selected {
    background: @overlayHover@;
}

/* ---- Preview Panel ---- */

#MailPreviewPanel {
    background-color: @contentBackground@;
}

#MailPreview {
    background: @background@;
    color: @textPrimary@;
    font-size: 13px;
    border: none;
    padding: 20px;
    selection-background-color: @accentOverlayHover@;
    selection-color: @textPrimary@;
}

/* ---- Remote file browser ---- */

#RemoteFilesView {
    background: transparent;
    color: @textPrimary@;
    font-size: 13px;
    border: 1px solid @border@;
    border-radius: 8px;
    outline: none;
    alternate-background-color: @overlayHover@;
}

#RemoteFilesView::item {
    padding: 7px 12px;
}

#RemoteFilesView::item:selected {
    background: @accentOverlay@;
    color: @accent@;
}

#RemoteFilesView::item:hover:!selected {
    background: @overlayHover@;
}

/* ==========================================================================
   Files Panel
   ========================================================================== */

#FilesPanel {
    background-color: @contentBackground@;
}

QLabel#FilesHeaderLabel {
    color: @textPrimary@;
    font-size: 18px;
    font-weight: 700;
    padding: 0 0 16px 0;
}

#FilesPanel QLabel#FolderAliasLabel {
    color: @textPrimary@;
    font-size: 14px;
    font-weight: 600;
}

#FilesPanel QLabel#FolderStatusLabel {
    color: @textSecondary@;
    font-size: 12px;
}

#FilesPanel QLabel#FolderErrorLabel {
    color: @danger@;
    font-size: 11px;
    padding: 4px 0 0 0;
}

#FilesPanel QPushButton {
    color: @accent@;
    background: transparent;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

#FilesPanel QPushButton:hover {
    color: @onAccent@;
    background: @accent@;
    border-color: @accent@;
}

#FilesPanel QLabel#EmptyLabel {
    color: @textDisabled@;
    font-size: 14px;
    padding: 48px 0;
}

#FolderRow {
    background: @background@;
    border: 1px solid @border@;
    border-radius: 10px;
    min-height: 60px;
}

#FolderRow:hover {
    background: @surfaceHover@;
    border-color: @borderStrong@;
}

QProgressBar#FolderProgressBar {
    background: @surface@;
    border: none;
    border-radius: 3px;
    min-height: 4px;
    max-height: 4px;
    text-align: center;
    font-size: 0px;
}

QProgressBar#FolderProgressBar::chunk {
    background: @accent@;
    border-radius: 3px;
}


/* ==========================================================================
   Shared panel styles (Talk, Deck, Kalender, Notizen)
   ========================================================================== */

#PanelToolbar {
    background-color: @background@;
    border-bottom: 1px solid @border@;
    min-height: 44px;
}

QLabel#PanelTitle {
    color: @textPrimary@;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#PanelPrimaryBtn {
    background: @accentGradient@;
    color: @onAccent@;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#PanelPrimaryBtn:hover {
    background: @accentHover@;
}

QPushButton#PanelPrimaryBtn:pressed {
    background: @accentPressed@;
}

QPushButton#PanelSecondaryBtn {
    background: transparent;
    color: @textSecondary@;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
}

QPushButton#PanelSecondaryBtn:hover {
    background: @surface@;
    color: @textPrimary@;
}

QLabel#PanelPlaceholder {
    color: @textMuted@;
    font-size: 15px;
}

QScrollArea#PanelScroll {
    border: none;
    background: transparent;
}

/* ---- Talk ---- */

QScrollArea#TalkChatArea {
    border: none;
    background: @contentBackground@;
}

QLineEdit#TalkMessageInput {
    background-color: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 18px;
    padding: 8px 16px;
    font-size: 13px;
}

QLineEdit#TalkMessageInput:focus {
    border: 1px solid @accent@;
}

/* ---- Deck ---- */

QLabel#DeckColumnTitle {
    color: @textPrimary@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#SettingsCardTitle {
    color: @textPrimary@;
    font-size: 14px;
    font-weight: 600;
}

QLabel#DeckColumnCount {
    color: @textSecondary@;
    background: @surfaceHover@;
    border-radius: 8px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#DeckColumnHeader {
    background: transparent;
    border-bottom: 2px solid @borderStrong@;
    padding: 2px 4px;
}

QToolButton#DeckBoardsButton,
QToolButton#DeckFilterButton {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 13px;
    color: @textPrimary@;
}

QToolButton#DeckBoardsButton:hover,
QToolButton#DeckFilterButton:hover {
    border-color: @accent@;
    background: @surfaceHover@;
}

QPushButton#DeckColumnAddBtn,
QToolButton#DeckColumnMenuBtn {
    color: @textMuted@;
    background: transparent;
    border: 1px solid @border@;
    border-radius: 6px;
}

QPushButton#DeckColumnAddBtn:hover,
QToolButton#DeckColumnMenuBtn:hover {
    color: @textPrimary@;
    border-color: @accent@;
    background: @surfaceHover@;
}

QLabel#DeckCardTitle {
    font-size: 13px;
    font-weight: 600;
    color: @textPrimary@;
    background: transparent;
}

QLabel#DeckCardDescription {
    font-size: 11px;
    color: @textSecondary@;
    background: transparent;
}

/* ==========================================================================
   General Widgets
   ========================================================================== */

QToolTip {
    background: @surface@;
    color: @textPrimary@;
    border: 1px solid @borderStrong@;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ---- Scrollbars ---- */

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: @borderStrong@;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: @textMuted@;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: @borderStrong@;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: @textMuted@;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
